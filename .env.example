# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Claude Code login, only for a "claude-..." MODEL. Run `claude setup-token`
# and paste the token. Not needed locally if you are signed in to Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: NVIDIA NIM API key from build.nvidia.com (starts with "nvapi-"). Needed for
# FALLBACK_MODEL, or when MODEL is a NIM model.
NVIDIA_API_KEY=

# Optional: restrict the bot to these Telegram user IDs (space or comma separated).
# Leave empty and anyone who finds the bot can use it.
ALLOWED_USER_IDS=

# Web search API. Optional at home; on a cloud host the keyless engines get blocked.
# Free at https://tavily.com — 1,000 searches a month, no card. Starts with "tvly-".
TAVILY_API_KEY=

# Lets the bot read SEC filings. EDGAR blocks unidentified clients; it wants an app name
# and a contact email, e.g. "StockThesisBot you@example.com". Empty skips sec.gov.
SEC_USER_AGENT=

# Deployment only: the timezone the container stamps onto PDF dates. Without it the
# server runs UTC and an evening pitch carries yesterday's date. e.g. Europe/London
TZ=UTC

# Optional tuning. "claude-..." runs through Claude Code; a NIM model must support tool
# calling. A Claude MODEL also does the research, with the same tools.
MODEL=nvidia/nemotron-3-ultra-550b-a55b
# low | medium | high | xhigh | max
CLAUDE_WRITE_EFFORT=high
CLAUDE_RESEARCH_EFFORT=medium
# Optional: Google AI Studio key (aistudio.google.com). Lets Gemini Flash write the pitch
# when MODEL keeps failing, on a different provider from NVIDIA.
GEMINI_API_KEY=
WRITE_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash
# With a NIM MODEL, research runs on Gemini when GEMINI_API_KEY is set (much faster than
# NIM's queue); with a Claude MODEL it stays on Claude. Set RESEARCH_MODEL to override.
# RESEARCH_MODEL=gemini-2.5-flash
# Optional: OpenRouter key (openrouter.ai). With it the reviewer runs on
# openrouter/google/gemma-4-31b-it:free, backed by a free Nemotron (no credits needed); set REVIEW_MODEL=openrouter/<vendor>/<model> to change.
OPENROUTER_API_KEY=
# Code-first SEC filing research is the default. Non-SEC companies fall back to the model loop.
RESEARCH_MODE=gather
# Used when MODEL is overloaded on NIM's free tier. Must also call tools. Empty disables.
FALLBACK_MODEL=openai/gpt-oss-20b
# Seconds a research turn on MODEL may wait in NIM's queue before switching to the fallback.
RESEARCH_FIRST_BYTE_S=60
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
TEMPERATURE=0.4
MAX_TOKENS=16000
MAX_TOOL_ROUNDS=10
# Filings, earnings releases or IR pages research must read before it may stop. 0 disables.
MIN_PRIMARY_FETCHES=1
# A second model reviews the finished pitch and sends high-severity issues back once.
REVIEW_ENABLED=1
REVIEW_MODEL=openai/gpt-oss-20b
REVIEW_FALLBACK_MODELS=deepseek-ai/deepseek-v4.1-flash,gemini-3.8-flash,gemini-2.5-flash
REVIEW_FIRST_BYTE_S=60
AUTO_REPAIR_NO_REASK=1
PATCH_REPAIRS=1
PLAN_REASK_WARNINGS=0
REVIEW_TIMEOUT_S=300
# Send each pitch's replay file after the PDF, for replays/ (see README). 0 disables.
SEND_REPLAY=1
